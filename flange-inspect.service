[Unit]
Description=推力保持架翻边止口 + 兜孔缺粒检测 (main_pipeline.py 产线主程序, 两站两进程)
# 相机是 169.254 link-local 直连网卡, 等网络起来再启动
After=network-online.target
Wants=network-online.target
# 崩溃重启不限次数(产线要一直在), 关掉 systemd 的启动频率熔断
StartLimitIntervalSec=0

[Service]
Type=simple
User=new
# 继电器 UNO 走串口(/dev/ttyUSB0), 需要 dialout 组才能打开
# ★ 只有主程序打开串口; 两个检测子进程只经 localhost 报判定, 不碰串口(见 station_link.py)
SupplementaryGroups=dialout
WorkingDirectory=/home/new/dev/thrust_cage_flange_inspect
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=UTF-8
# 两站的相机 IP 由 main_pipeline.py 顶部 STATIONS 显式指定(169.254.44.201 / .202)。
# 必须是显式的: 两台相机同时在网时 inspector_pure 的自动探测(只认"唯一应答者")必然失败。
# 产线参数(--mode camera --holes 0 --quiet等)同样在 STATIONS 的 argv 里, 不在这里传,
# 免得同一份配置在两个地方各写一遍、改一处漏一处。
ExecStart=/home/new/dev/thrust_cage_flange_inspect/run_pipeline.sh
Restart=always
RestartSec=5
# 日志输出到systemd journal，方便远程排查
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
